<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 Crypto Visor PRO"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Honor Magic6 Lite &bull; Barra Flotante 24/7"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <!-- Card de Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#121215"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Detenido"
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2563EB"
                android:text="▶ Iniciar Barra Flotante"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card de Permisos del Sistema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#121215"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Permisos Necesarios en MagicOS"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#18181B"
                android:text="1. Permitir Superposición sobre otras apps"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRequestBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#18181B"
                android:text="2. Desactivar Optimización de Batería (24/7)"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card Centro de Simulación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#121215"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 Centro de Simulación"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSimMegaShock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#7F1D1D"
                android:text="🚨 Probar Sirena MEGA SHOCK"
                android:textColor="#FECACA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
