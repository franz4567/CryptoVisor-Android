<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <!-- Símbolo -->
    <TextView
        android:id="@+id/tvTickerSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BTC"
        android:textColor="#E4E4E7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Precio -->
    <TextView
        android:id="@+id/tvTickerPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="68450.00"
        android:textColor="#F4F4F5"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Cambio % 24h -->
    <TextView
        android:id="@+id/tvTickerChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:text="+2.40%"
        android:textColor="#4ADE80"
        android:textSize="10sp" />

    <!-- Badges [V] [F] [E] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBadgeV"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#27272A"
            android:gravity="center"
            android:text="V"
            android:textColor="#71717A"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBadgeF"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="1dp"
            android:background="#27272A"
            android:gravity="center"
            android:text="F"
            android:textColor="#71717A"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBadgeE"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="1dp"
            android:background="#27272A"
            android:gravity="center"
            android:text="E"
            android:textColor="#71717A"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:background="#27272A" />

</LinearLayout>
